--[[
	Gunsmith part tree callbacks.
	The engine calls the _G.CWeapon_gs_* functions below; they forward to script
	callbacks that any script can register with RegisterScriptCallback.

	on_gs_part_attached(weapon, node, section)
		A part went into the weapon's tree: through game_object:gs_attach,
		gs_attach_section, or the inventory (scopes, silencers, launchers).
		node is its 0-based node number.

	on_gs_part_detached(weapon, section, item_id)
		A part left the tree. item_id is the spawned inventory item's id, or -1
		when no item was spawned or its id isn't known yet (inventory detach of
		an old-style addon spawns the item asynchronously).

	on_gs_part_failed(weapon, node, failure_type)
		The weapon jammed, and this part caused it. failure_type is "misfire"
		(node 0, the gun's own curve), "extraction", "feed" or "barrel".
		Fires for the player and NPCs, before the existing weapon_jammed callback.

	weapon_on_recalc_stats(weapon, t)
		The engine recomputed a weapon's stats from its parts: at spawn and load, when a part goes on or
		off, a condition is set, gunsmith.refresh_stats() runs, and for the builder's previews (t.preview
		true: a build the weapon doesn't have yet). Not per shot. Any weapon, the player's and NPCs'.
		t holds the parts' totals, with the stock build's (gs_default_build): t.section, t.recoil and
		t.stock_recoil (summed recoil percents), t.ergonomics and t.stock_ergonomics, t.shoulder and
		t.stock_shoulder (shoulder contact). Handlers multiply into t.mul and add into t.add by stat name
		(the names gs_get_stats() lists: cam_dispersion, zoom_rotate_time, pdm_base, ...), on top of what
		the parts give, e.g. t.mul.cam_dispersion = (t.mul.cam_dispersion or 1) * 1.1. The engine keeps
		them until the next recompute. Gunsmith's Tarkov handling is one handler (gunsmith_handling).
--]]

AddScriptCallback("on_gs_part_attached")
AddScriptCallback("on_gs_part_detached")
AddScriptCallback("on_gs_part_failed")
AddScriptCallback("weapon_on_recalc_stats")

_G.CWeapon_gs_part_attached = function(weapon, node, section)
	SendScriptCallback("on_gs_part_attached", weapon, node, section)
end

_G.CWeapon_gs_part_detached = function(weapon, section, item_id)
	SendScriptCallback("on_gs_part_detached", weapon, section, item_id)
end

_G.CWeapon_gs_part_failed = function(weapon, node, failure_type)
	SendScriptCallback("on_gs_part_failed", weapon, node, failure_type)
end

_G.CWeapon_OnRecalcStats = function(weapon, t)
	SendScriptCallback("weapon_on_recalc_stats", weapon, t)
end
