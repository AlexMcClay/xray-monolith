--[[
	Gunsmith part tree callbacks.
	The engine calls the _G.CWeapon_gs_* functions below; they forward to script
	callbacks that any script can register with RegisterScriptCallback.

	on_gs_part_attached(weapon, node, section)
		A part went into the weapon's tree: through game_object:gs_attach
		or the inventory (scopes, silencers, launchers).
		node is its 0-based node number.

	on_gs_part_detached(weapon, section, item_id)
		A part left the tree. item_id is the spawned inventory item's id, or -1
		when no item was spawned or its id isn't known yet (inventory detach of
		an old-style addon spawns the item asynchronously).

	on_gs_part_failed(weapon, node, failure_type)
		The weapon jammed; node is the part a script named as its cause (weapon_on_shot), or 0 (the gun).
		failure_type is "misfire", "extraction", "feed", "barrel" (soft slide) or "hard_slide".
		Fires for the player and NPCs, before the existing weapon_jammed callback.

	weapon_on_shot(weapon, owner, t)
		A shot is about to be fired (the player's or an NPC's, owner nil when nobody holds the weapon).
		t.condition (the weapon's, 0..1), t.rounds_left (in the magazine after this shot), t.magazine_size,
		t.ammo (the round's section). Set t.handled = true to decide the shot: t.wear (condition lost, 0..1,
		before Anomaly's weapon degradation setting; leave it nil for the engine's own wear), t.malfunction
		("misfire", "extraction", "feed", "barrel", "hard_slide", or nil for none) and t.node (the culprit
		part's node, 0 for the gun). Unhandled, the engine uses the weapon's own misfire curve and wear.
		The Gunsmith Framework's Tarkov malfunctions are a handler (gunsmith_malfunctions).

	weapon_on_recalc_stats(weapon, t)
		The engine recomputed a weapon's stats from its parts: at spawn and load, when a part goes on or
		off, when gunsmith.refresh_stats() runs, and for the builder's previews (t.preview
		true: a build the weapon doesn't have yet). Not per shot. Any weapon, the player's and NPCs'.
		t.section is the weapon's; t.can_fire false when a required slot is empty; t.parts the fitted part sections (old-style addons included) and
		t.stock_parts its stock build's (gs_default_build), for handlers to read their own keys from.
		Handlers multiply into t.mul and add into t.add by stat name (the names gs_get_stats() lists:
		cam_dispersion, zoom_rotate_time, pdm_base, ...), on top of what the parts give, e.g.
		t.mul.cam_dispersion = (t.mul.cam_dispersion or 1) * 1.1, and may set t.ergonomics (a number) and
		t.no_stock (true) for gs_get_stats() and the previews to show. The engine keeps them until the next
		recompute. Gunsmith's Tarkov handling is one handler (gunsmith_handling).

	weapon_on_alt_aim_key(weapon, t)
		The player pressed the alternative-aim key (wpn_func, V by default) with this weapon. Set
		t.handled = true to take the key: the engine then does nothing more. Unhandled, the engine does
		vanilla's alternative aim or launcher. The Gunsmith Framework's sight switching is a handler
		(gunsmith_sights).

	weapon_shot_indoors(weapon, pos, t)
		A queue of shots starts (its first shot) on a weapon whose shot sounds have indoor twins (<key>_indoor):
		how much is it indoors? pos is the fire point. Set t.mix, the indoor share from 0 (outdoors) to 1
		(indoors): the engine crossfades the outdoor and indoor sounds by it (the single shot, the firing loop and
		its tail; for a firing loop it asks again every 0.2 s while the loop plays). Several handlers: take the
		largest (t.mix = math.max(t.mix or 0, yours)). t.indoor = true is the older yes or no, for an engine
		without the crossfade (and the share 1 when no handler sets t.mix). The player's and NPCs' guns. The
		engine doesn't decide this itself (since 10 Nov 2026, roadmap So6); the Gunsmith Framework's
		gunsmith_indoor answers it.

	sound_indoor_mix(pos, obj, t)
		Any other sound with an indoor twin (an explosive's snd_explode_indoor, engine 11 Nov 2026): how much is
		a sound at pos indoors? obj is its owner or nil. Set
		t.mix (0..1) as for weapon_shot_indoors (several handlers: the largest). Nobody answering: outdoors.
--]]

AddScriptCallback("on_gs_part_attached")
AddScriptCallback("on_gs_part_detached")
AddScriptCallback("on_gs_part_failed")
AddScriptCallback("weapon_on_recalc_stats")
AddScriptCallback("weapon_on_alt_aim_key")
AddScriptCallback("weapon_on_shot")
AddScriptCallback("weapon_shot_indoors")
AddScriptCallback("sound_indoor_mix")

_G.CWeapon_gs_part_attached = function(weapon, node, section)
	SendScriptCallback("on_gs_part_attached", weapon, node, section)
end

_G.CWeapon_gs_part_detached = function(weapon, section, item_id)
	SendScriptCallback("on_gs_part_detached", weapon, section, item_id)
end

_G.CWeapon_gs_part_failed = function(weapon, node, failure_type)
	SendScriptCallback("on_gs_part_failed", weapon, node, failure_type)
end

_G.CWeapon_OnRecalcStats = function(weapon, t)
	SendScriptCallback("weapon_on_recalc_stats", weapon, t)
end

_G.CWeapon_OnAltAimKey = function(weapon)
	local t = { handled = false }
	SendScriptCallback("weapon_on_alt_aim_key", weapon, t)
	return t.handled == true
end

_G.CWeapon_OnShot = function(weapon, owner, t)
	SendScriptCallback("weapon_on_shot", weapon, owner, t)
end

_G.CWeapon_ShotIndoors = function(weapon, pos)
	local t = { indoor = false }
	SendScriptCallback("weapon_shot_indoors", weapon, pos, t)
	return t.indoor == true
end

-- the crossfade's question (engine branch feature/shot-blend): the indoor share 0..1
_G.CWeapon_ShotIndoorMix = function(weapon, pos)
	local t = { indoor = false, mix = nil }
	SendScriptCallback("weapon_shot_indoors", weapon, pos, t)
	if type(t.mix) == "number" then
		return math.min(math.max(t.mix, 0), 1)
	end
	return t.indoor == true and 1 or 0
end

-- any other sound's indoor share (an explosive's snd_explode_indoor; engine HUD_SOUND_COLLECTION_LAYERED::IndoorMix)
_G.CSound_IndoorMix = function(pos, obj)
	local t = { mix = 0 }
	SendScriptCallback("sound_indoor_mix", pos, obj, t)
	return math.min(math.max(tonumber(t.mix) or 0, 0), 1)
end
